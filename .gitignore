# UniConnect — Root .gitignore
# ============================================================

# ── Node / NPM ──────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.pnp
.pnp.js

# ── Environment files (NEVER commit secrets) ────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example

# ── Build output ────────────────────────────────────────────
dist/
build/
out/

# ── Logs ────────────────────────────────────────────────────
logs/
*.log

# ── OS generated ────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE / Editor ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Test coverage ───────────────────────────────────────────
coverage/
.nyc_output/

# ── Backend uploads (user-generated content) ────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ── Misc ────────────────────────────────────────────────────
.cache/
.parcel-cache/
*.tsbuildinfo
