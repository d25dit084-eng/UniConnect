# UniConnect Backend — Environment Variables Example
# =====================================================
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to version control.

# ── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Connection ───────────────────────────────
# Use 127.0.0.1 instead of localhost to avoid IPv6 ECONNREFUSED on some systems
MONGO_URI=mongodb://127.0.0.1:27017/uniconnect

# ── JWT Secrets ──────────────────────────────────────
# Use long, random strings in production (e.g. openssl rand -hex 64)
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ── CORS ─────────────────────────────────────────────
# Frontend URL (dev: Vite default port)
CLIENT_URL=http://localhost:5173

# ── Email (SMTP) ─────────────────────────────────────
# Optional in development — password reset tokens are logged to console if unset
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=noreply@yourdomain.com
EMAIL_PASS=replace_with_email_password
EMAIL_FROM=noreply@uniconnect.dev

# ── Cloudinary (optional — for image uploads) ────────
# Leave blank to use local disk uploads (/uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
